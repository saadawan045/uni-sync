[Unit]
Description=uni-sync: WeBWorK due dates
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Environment=HOME=@HOME@
Environment=UNISYNC_DATA=@DATA@
WorkingDirectory=@DIR@
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ExecStart=@DIR@/.venv/bin/python -m unisync webwork-sync
TimeoutStartSec=15min
Nice=10
